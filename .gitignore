# Virtual environments
env/
venv/
# Dataset
datasets/LLVIP/
datasets/M3FD/
datasets/*.zip
datasets/thermal/
datasets/visible/


# Python cache
__pycache__/
*.py[cod]

# Environment variables
.env
# Phase 5 training outputs: checkpoints and TensorBoard logs.
# Note runs/visualizations/ is deliberately NOT ignored - the Phase 3/4
# figures under it are committed deliverables.
runs/fusion/
runs/baselines/
runs/ablation/
runs/predictions/
weights/fusion/
weights/baselines/
weights/ablation/

# Copyrighted third-party reference papers (IEEE/Elsevier/ACM/MDPI) - do not
# redistribute. TriNetra's own paper draft lives in "TRI-Netra Research Paper/".
IMP Research Paper/

# Raw surveillance video clips (~830 MB; several exceed GitHub's 100 MB file
# limit). Kept locally only; see PHASE6_TRACKING_IMPLEMENTATION.md for how the
# clips are used.
datasets/RGB/*.mp4

# ReID appearance-embedding caches (15-58 MB each). Regenerate with
# utils/compute_reid_cache.py.
*.embeds.npz

# Run logs
*.log

# Research paper drafts and the copyright registration are kept private
# (not distributed with the code).
TRI-Netra Research Paper/
Copyright-TriNetra*.pdf
